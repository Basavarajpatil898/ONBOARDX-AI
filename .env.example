APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:root@localhost:5432/onboardx
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long
JWT_EXPIRY_MINUTES=60
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_WEB_SEARCH_ENABLED=true
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
MAX_UPLOAD_BYTES=10485760
ONBOARDX_ADMIN_EMAIL=admin@example.com
ONBOARDX_ADMIN_PASSWORD=replace-this-with-a-unique-password-of-12-characters-or-more
